<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Reporte de referencia</title>

    <style>
        html { scroll-behavior: smooth; }
        body { font-family: Inter, Arial, sans-serif; color: #1f2937; line-height: 1.55; align-content: center; background: #f4f7f6}
        h1 { font-size: 2.2em; margin-bottom: 0.2em; color: #0062a4; }
        h2 { margin-top: 48px; padding-bottom: 6px; border-bottom: 2px solid #e5e7eb; color: #0062a4; }
        h3 { margin-top: 32px; color: #0062a4; }
        ol { padding: 0 48px; }
        li { color: #0062a4 ; }
        strong { color: #0062a4; }
        p.muted { color: #6b7280; font-size: 0.95em; }
        a:visited { color: #0062a4; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        th { background: #f9fafb; font-weight: 600; }
        img { object-fit: scale-down; }
        table caption { caption-side: bottom; font-size: medium; }
        table th { background: #003366; color: white; padding: 8px; text-align: center;  }
        table td { border-bottom: 1px solid #eee; padding: 8px; vertical-align: top; text-align: center; }
        footer { display: flex; align-content: center; justify-content: center; padding: 2rem 0 0 0; margin: 0 auto; } 
        .caption { padding-top: 1rem; }
        .detail { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .content { padding: 0 40px; width: 900px; box-shadow: 0 0 10px rgba(0,0,0,0.1); margin: 0 auto; background: white; }
        .resume { display: flex; justify-content: space-between; padding: 0 10rem 1rem 10rem; }
        .small { font-size: 13px; }
        .li-section { font-size: x-large; }
        .col { display: flex; flex-direction: column; }
        .logo { height: 100px; width: 300px; padding-left: 2rem; }
        .header { background: #0062a4; width: auto; height: 150px; align-content: center; }
        .badge { padding: 4px 10px; border-radius: 14px; font-size: 0.8em; font-weight: 600; white-space: nowrap; }
        .good { background: #0062a4; color: white; }
        .avg  { background: #fef3c7; color: #92400e; }
        .bad  { background: #fee2e2; color: #991b1b; }
        .section { margin-top: 48px; display: flex; flex-direction: column; gap: 1rem; }
        .chart { margin: 18px auto; text-align: center; max-width: 400px; max-height: 400px;}
        .grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; }
        .dimension-header { background-color: #4a90e2; color: white; font-weight: bold; text-align: left; }
        .question-row { background-color: #e6f0fa; }
        .indent { padding-left: 1rem; display: flex}
        .indent2 { padding-left: 2rem; display: flex}
        tr.hoverable:hover, .adoption-row:hover { background: #f9fafb; cursor: pointer; }
        @media print { body { margin: 20px; } }
    </style>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<div class="content">
<header class="header">
    <img src="./static/tareando_logo.png" alt="Tareando Logo" class="logo"/>
</header>

<h1>Informe Digital de Referencia</h1>
<p class="muted col">
    <div class="resume">
        {% for key, value in meta.items() %}
            <span><strong data-key={{ key }}></strong>: <i data-key={{ value }}></i></span>{% if not loop.last %} {% endif %}
        {% endfor %}
    </div>
    
    <span>
        <strong>Informe Digital de Referencia</strong> para la comparación estructurada entre las respuestas proporcionadas y el sector proporcionado. A continuación se mostrarán diferentes tablas y gráficos con el objetivo de comparar las cualidades de la empresa proporcionada en comparación con las agregadas.
    </span>
</p>

<ol>
<!-- ================= KPI RADAR + GLOBAL SCORE ================= -->
<h3>Índice</h3>
    <ol>
        <li><a href="#indices-globales">Valores KPI y Puntuación Global</a></li>
        <li><a href="#adopcion-tecnologica">Adopción Tecnológica</a></li>
        <li><a href="#posicion-mercado">Posición del Mercado</a></li>
        <li><a href="#respuestas">Respuestas</a></li>
    </ol>
<div class="section">
    <strong id="indices-globales"><li class="li-section">Valores KPI y Puntuación Global</li></strong>
    <p class="muted">Radar de cualidades <a href="#kpi-description"><i>Key Performance Indicator (KPI)</i></a> y Puntuación Global (media de KPIs) comparada con las medianas del sector. Además de los datos originales de las gráficas y la explicación de cada KPI. És un buen indicativo del nivel general comparado con el sector especificado.</p>
    <div class="grid">
        <div class="chart">
            <canvas id="kpi-radar-chart" width="400" height="400"></canvas>
        </div>

        <div class="chart">
            <canvas id="global-score-chart" width="400" height="200"></canvas>
        </div>
    </div>

    <table id="kpi-comparison" class="small">
        <tbody>
            <tr>
                <th>KPI</th>
                <th>Puntuación</th>
                <th>Mediana</th>
                <th>Diferencia</th>
                <th>Posición</th>
            </tr>
            {% for kpi, d in kpis.items() %}
            <tr>
            <td class="i18n" data-key={{ kpi }} />
            <td><strong>{{ d.company | default(0) }}</strong></td>
            <td>{{ d.sector_median | default(0) }}</td>
            <td>
            {% if d.company-d.sector_median > 0 %}
            <span class="badge good">+{{ (d.company-d.sector_median)|round(2) }}</span>
            {% elif d.sector_median - d.company == 0 %}
            <span class="badge avg">{{ (d.company-d.sector_median)|round(2) }}</span>
            {% else %}
            <span class="badge bad">{{ (d.company-d.sector_median)|round(2) }}</span>
            {% endif %}
            </td>
            <td>
                {% if d.position in ["above_p75", "between_median_p75"] %}
                    <span class="badge good">Por encima de la media</span>
                {% elif d.position == "between_p25_median" %}
                    <span class="badge avg">Media</span>
                {% else %}
                    <span class="badge bad">Por debajo de la media</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    <table id="kpi-description" class="methodology-table small">
        <tr>
            <th>KPI (Dimensión)</th>
            <th>Qué mide</th>
            <th>Columnas / Preguntas utilizadas</th>
        </tr>
        <tr>
            <td><strong>Eficiencia Operativa</strong><br>(KPI Operacional)</td>
            <td>Nivel de modernización de la infraestructura y procesos.</td>
            <td>
                <ul>
                    <li><em>% Procesos digitalizados (40%)</em></li>
                    <li><em>Infraestructura (Cloud vs On-Prem) (30%)</em></li>
                    <li><em>Uso de herramientas colaborativas (15%)</em></li>
                    <li><em>¿Usas PowerBI para la analítica empresarias de tu negocio? (15%)</em></li>
                </ul>
            </td>
        </tr>
        <tr>
            <td><strong>Negocio Digital</strong><br>(KPI Empresarial)</td>
            <td>Capacidad de generar valor e ingresos a través de la tecnología.</td>
            <td>
                <ul>
                    <li><em>% Ingresos Digitales (40%)</em></li>
                    <li><em>Uso de IA para automatización (20%)</em></li>
                    <li><em>Presencia activa en Internet (20%)</em></li>
                    <li><em>Uso de marketing digital (20%)</em></li>
                </ul>
            </td>
        </tr>
        <tr>
            <td><strong>Ciberseguridad</strong><br>(KPI Seguridad)</td>
            <td>Nivel de protección y cumplimiento normativo (Higiene Digital).</td>
            <td>
                <ul>
                    <li><em>Autenticación de Doble Factor (2FA) (25%)</em></li>
                    <li><em>Planes de Continuidad/Backups (25%)</em></li>
                    <li><em>Simulacros de Phishing (25%)</em></li>
                    <li><em>Cumplimiento RGPD/Datos (25%)</em></li>
                </ul>
            </td>
        </tr>
        <tr>
            <td><strong>Cultura Digital</strong><br>(KPI Cultural)</td>
            <td>Capacitación y preparación del capital humano.</td>
            <td>
                <ul>
                    <li><em>% Empleados con skills avanzados (25%)</em></li>
                    <li><em>Formación específica en Ciberseguridad (25%)</em></li>
                    <li><em>¿Existe política de uso aceptable para el teletrabajo? (25%)</em></li>
                    <li><em>¿Qué porcentaje de tus empleados usan antivirus? (25%)</em></li>
                </ul>
            </td>
        </tr>
    </table>
    
</div>

<!-- ================= ADOPTION (INTERACTIVE) ================= -->
<div class="section">
    <strong id="adopcion-tecnologica"><li class="li-section">Adopción Tecnológica</li></strong>
    <p class="muted">Comparativa entre las competencias proporcionadas y la su adopción en el sector.</p>
    <div class="grid">
        <div>
            <table id="adoption-table" class="small">
                <tr>
                    <th>Competencias</th>
                    <th>Respuesta</th>
                    <th>Adopción del mercado</th>
                </tr>
                {% for item, d in adoption.items() %}
                <tr class="adoption-row" data-label="{{ item }}" data-sector="{{ d.sector_adoption_pct | default(0) }}">
                    <td class="i18n" data-key={{ item }} />
                    <td>{{ '<span class="badge good">Sí</span>' if d.company else '<span class="badge bad">No</span>' }}</td>
                    <td>{{ d.sector_adoption_pct | default(0) }}%</td>
                </tr>
                {% endfor %}
            </table>
        </div>
        <div class="chart">
            <canvas id="adoption-detail-chart" width="200" height="200"></canvas>
            <p class="muted detail" id="adoption-detail-label">Pasa el ratón por encima de la competecia o clica para ver la Adopción del Sector</p>
        </div>
    </div>
</div>

<!-- ================= MARKET POSITION ================= -->
<div class="section">
    <strong id="posicion-mercado"><li class="li-section">Posición del Mercado</li></strong>
    <p class="muted">A continuación, mostraremos la posición del mercado (popularidad) de las diferentes dimensiones de las respuestas.</p>
    
    <div class="grid">
        <table id="posicion-mercado" class="small"> 
            <tr>
                <th>Dimensión</th>
                <th>Respuesta</th>
                <th>Posición en el Mercado</th>
                <th>Cuota de Mercado</th>
            </tr>
            {% for item, d in market_position.items() %}
            <tr class="hoverable market-row"
                data-dim="{{ item }}"
                data-share="{{ d.market_share_pct | default(0) }}">
                <td class="i18n" data-key={{ item }} />
                <td>{{ d.company }}</td>
                <td>{{ "#" ~ d.market_rank if d.market_rank else "Nicho" }}</td>
                <td>{{ d.market_share_pct | default(0) }}%</td>
            </tr>
            {% endfor %}
        </table>

        <div class="chart">
            <canvas id="market-detail-chart" width="200" height="200"></canvas>
            <p class="muted detail" id="market-detail-label">
                Pasa el ratón por encima de la dimensión o clica para ver la Posición del Mercado
            </p>
        </div>
    </div>
</div>

<div class="section">
    <strong id="respuestas"><li class="li-section">Respuestas</li></strong>
    <p class="muted">Por último, mostraremos directamente las respuestas proporcionadas comparadas con los datos agregados. Para leer esta <a href="#respuestas-table">Tabla <span id="table-number"></span></a>, deberemos tener en cuenta que en la columna <i>Comparación sectorial</i> hay dos tipos de datos. Primero, el dato numérico, que es un valor numérico abierto (el caso de <i>Número clientes</i>), en el cual se mostrará la diferencia entre el valor aportado y la mediana del sector. Por último, con el dato categórico, el cual es mayoritario, mostrará el porcentaje del sector que ha proporcionado la misma respuesta que la proporcionada.</p>

    <table id="respuestas-table" class="small">
        <thead>
            <tr>
                <th>Pregunta</th>
                <th>Respuesta</th>
                <th>Comparación sectorial</th>
            </tr>
        </thead>

        <tbody>
            {% set ns = namespace(counter=0) %}
            {% for dimension in responses %}
                {% if dimension %}
                    <tr class="dimension-header">
                        <td colspan="3"><div class="indent">{{loop.index0}}. {{ dimension_labels[loop.index0] }}</div></td>
                    </tr>

                    {% for row in dimension %}
                        {% set ns.counter = ns.counter + 1 %}
                        <tr class="question-row">
                            <td><div class="indent2">{{ ns.counter }}. {{ row.question }}</div></td>
                            <td>{{ row.company }}</td>
                            <td>
                                {% if row.comparison.type == "numerical" %}
                                    {% if row.comparison.gap > 0 %}
                                        <span class="badge good">+{{ row.comparison.gap }}</span>
                                    {% elif row.comparison.gap == 0 %}
                                        <span class="badge avg">{{ row.comparison.gap }}</span>
                                    {% else %}
                                        <span class="badge bad">{{ row.comparison.gap }}</span>
                                    {% endif %}
                                {% elif row.comparison.type == "categorical" %}
                                    {{ row.comparison.value }}%
                                {% else %}
                                    N/A
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            {% endfor %}
        </tbody>
    </table>

</div>


</ol>
<!-- ================= FOOTER ================= -->
<footer>
    <p class="muted">Generado automáticamente · Valores comparados contra datos sectoriales agregados.</p>
</footer>


<!-- ================= CHART.JS SCRIPTS ================= -->
<script>
    /* Tables and Graphs */
    let tableNumber = 0;
    let graphNumber = 0;
    
    const translatedCaption = (key, type) => ({
        "number": type == "table" ? ++tableNumber : ++graphNumber,
        "label": translate(key)
        }
    )

    /* Translations */
    TRANSLATIONS = {{ translations }}
    
    const translate = (s) => {
        return TRANSLATIONS[s] ?? s
    }
    
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".i18n").forEach((el) => {
            el.textContent = translate(el.dataset.i18n);
        });
        document.querySelectorAll("[data-key]").forEach((el) => {
            el.textContent = translate(el.dataset.key);
        });
        document.querySelectorAll("canvas[id]").forEach(canvas => {
            if (canvas.parentElement.tagName.toLowerCase() === "figure") return;

            const content = translatedCaption(canvas.id, "graph")

            const figure = document.createElement("figure");
            figure.style.display = "inline-block"; 
            figure.style.textAlign = "center";     
            figure.style.margin = "0";     
            
            canvas.parentNode.insertBefore(figure, canvas);
            figure.appendChild(canvas);

            const figcaption = document.createElement("figcaption");

            const strong = document.createElement("strong");
            strong.textContent = `Gráfico ${content.number} `;
            const labelSpan = document.createElement("span");
            labelSpan.textContent = content.label;

            figcaption.classList.add("caption")

            figcaption.appendChild(strong)
            figcaption.appendChild(labelSpan)

            figure.appendChild(figcaption);
        });
        document.querySelectorAll("table[id]").forEach(table => {
            if (table.querySelector("caption")) return;

            const content = translatedCaption(table.id, "table");

            const caption = document.createElement("caption");
            caption.classList.add("caption")

            const strong = document.createElement("strong");
            strong.textContent = `Tabla ${content.number} `;

            const labelSpan = document.createElement("span");
            labelSpan.textContent = content.label;

            caption.appendChild(strong);
            caption.appendChild(labelSpan);

            table.appendChild(caption);
        });

        document.querySelectorAll("#table-number").forEach((el) => {
            el.textContent = tableNumber;
        })
    });

    /* KPI Radar */
    const kpiKeys = {{ kpis.keys() | list | tojson }};
    const kpiLabels = kpiKeys.map(translate)
    const companyData = {{ kpis.values() | map(attribute='company') | map('default',0) | list | tojson }};
    const sectorData = {{ kpis.values() | map(attribute='sector_median') | map('default',0) | list | tojson }};

    new Chart(document.getElementById("kpi-radar-chart"), {
        type:'radar',
        data:{
            labels: kpiLabels,
            datasets:[
                { label:'Respuestas proporcionadas', data:companyData, fill:true, backgroundColor:'rgba(37,99,235,0.25)', borderColor:'#0062a4', pointBackgroundColor:'#0062a4' },
                { label:'Mediana del sector', data:sectorData, fill:true, backgroundColor:'rgba(156,163,175,0.15)', borderColor:'#9ca3af', borderDash:[5,5], pointBackgroundColor:'#9ca3af' }
            ]
        },
        options:{ responsive:true, scales:{ r:{ min:0, max:100, ticks:{ stepSize:20 } } }, plugins:{ legend:{ position:'top' }, title:{ display:true, text:'Comparación de KPIs' } } }
    });

    /* Global Score */
    const globalScoreData = [{{ kpis.GLOBAL_SCORE.company | default(0) }}, {{ kpis.GLOBAL_SCORE.sector_median | default(0) }}];
    new Chart(document.getElementById("global-score-chart"), {
    type: 'bar',
    data: {
        labels: ['Respuestas proporcionadas', 'Mediana del Sector'],
        datasets: [{
            data: globalScoreData,
            backgroundColor: [
                "{{ '#0062a4' if kpis.GLOBAL_SCORE.company >= kpis.GLOBAL_SCORE.sector_median else '#dc2626' }}",
                '#9ca3af'
            ]
        }]
    },
    options: {
        indexAxis: 'y',
        responsive: true,
        scales: {
            x: {
                max: 100,
                title: {
                    display: true,
                    text: 'Puntuación (%)'
                }
            }
        },
        plugins: {
            legend: { display: false },
            title: {
                display: true,
                text: 'Puntuación Global'
            }
        }
    }
});

    /* Adoption Interactive */
    const adoptionCtx = document.getElementById("adoption-detail-chart");
    const adoptionChart = new Chart(adoptionCtx, {
        type:'pie',
        data:{ labels:['Adopted','Not Adopted'], datasets:[{ data:[0,100], backgroundColor:['#0062a4','#e5e7eb'] }] },
        options:{ responsive:true, plugins:{ legend:{ position:'bottom' } } }
    });
    document.querySelectorAll(".adoption-row").forEach(row=>{
        row.addEventListener("mouseenter", ()=>{
            const label = row.dataset.label;
            const sector = parseInt(row.dataset.sector,10);
            adoptionChart.data.datasets[0].data = [sector,100-sector];
            adoptionChart.update();
            document.getElementById("adoption-detail-label").textContent=`Adopción del sector a "${translate(label)}"`;
        });
    });
    /* ---------------- Market Position Interactive ---------------- */
    const marketCtx = document.getElementById("market-detail-chart");
    const marketChart = new Chart(marketCtx, {
        type: 'pie',
        data: {
            labels: ['Company', 'Others'],
            datasets: [{
                data: [0, 100],
                backgroundColor: ['#0062a4', '#e5e7eb']
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } }
        }
    });

    document.querySelectorAll(".market-row").forEach(row => {
        const updateMarketChart = (row) => {
            const dim = row.dataset.dim;
            const share = parseFloat(row.dataset.share || 0);

            marketChart.data.datasets[0].data = [share, 100 - share];
            marketChart.update();

            document.getElementById("market-detail-label").textContent =
                `Posición del mercado de "${translate(dim)}"`;
        }
        
        row.addEventListener("click", (_) => updateMarketChart(row));
        row.addEventListener("mouseenter", (_) => updateMarketChart(row));
    });
</script>
</div>
</body>
</html>