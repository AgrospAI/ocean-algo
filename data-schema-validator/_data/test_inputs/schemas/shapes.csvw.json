{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Author CSV Row Schema",
  "type": "object",
  "additionalProperties": false,

  "required": ["id", "name", "nationality", "gender"],

  "properties": {
    "id": {
      "type": "string",
      "format": "uri"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "alternateName": {
      "type": "string"
    },

    "nationality": {
      "type": "string",
      "minLength": 1
    },

    "gender": {
      "type": "string",
      "enum": ["Male", "Female", "Non-Binary", "Other"]
    },

    "jobTitle": {
      "type": "string"
    },

    "worksFor_name": {
      "type": "string"
    },

    "worksFor_url": {
      "type": "string",
      "pattern": "^(https?:\\/\\/[^|]+)(\\|https?:\\/\\/[^|]+)*$"
    },

    "addressLocality": {
      "type": "string"
    },

    "addressRegion": {
      "type": "string",
      "maxLength": 10
    },

    "addressCountry": {
      "type": "string"
    },

    "sameAs": {
      "type": "string",
      "pattern": "^(https?:\\/\\/[^|]+)(\\|https?:\\/\\/[^|]+)*$"
    },

    "book_name": {
      "type": "string"
    },

    "book_isbn": {
      "type": "string",
      "pattern": "^([0-9Xx\\-]{10,17})(\\|[0-9Xx\\-]{10,17})*$"
    }
  }
}
